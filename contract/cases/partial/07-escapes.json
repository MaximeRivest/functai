   "expect": {
    "value": {
     "t": "a\n"
    }
   }
  },
  {
   "text": "{\"t\": \"a\\",
   "expect": {
    "value": {
     "t": "a"
    }
   }
  },
  {
   "text": "{\"t\": \"\\u00e9t",
   "expect": {
    "value": {
     "t": "ét"
    }
   }
  },
  {
   "text": "{\"t\": \"\\u00e",
   "expect": {
    "value": {
     "t": ""
    }
   }
  },
  {
   "text": "{\"t\": \"\\ud83d",
   "expect": {
    "value": {
     "t": ""
    }
   }
  },
  {
   "text": "{\"t\": \"\\ud83d\\ude00!\"}",
   "expect": {
    "value": {
     "t": "😀!"
    }
   }
  },
  {
