{
 "name": "functai_json",
 "versions": {
  "kernel": "0.8.3",
  "vocab": {
   "format/json": "0.1.0",
   "format/function_tool": "0.1.0",
   "format/tool_calls": "0.1.0",
   "reader/json_object": "0.2.0"
  }
 },
 "template": [
  {
   "role": "system",
   "text": "{instruction}"
  },
  {
   "directive": "turns"
  },
  {
   "role": "user",
   "text": "{% for f in inputs %}<{f.name}>\n{f.value}\n</{f.name}>\n{% endfor %}"
  }
 ],
 "reader": {
  "kind": "json_object"
 },
 "transports": {
  "tools": {
   "choose": [
    {
     "when": {
      "capability": "native_function_calling"
     },
     "use": {
      "requires": [
       "native_function_calling"
      ],
      "in_template": false,
      "put": {
       "@purpose": "request.tools"
      },
      "find": [
       {
        "from": "part:tool_call",
        "to": "@purpose.calls",
        "complete_reply": true
       }
      ]
     }
    },
    {
     "else": {
      "requires": [
       "instruct"
      ],
      "in_template": false,
      "tell": {
       "system": "You may call a tool by replying with exactly one fenced block:\n```tool\n{\"name\": \"<tool>\", \"input\": {...}}\n```\nand nothing else; you will be given the result and asked again."
      },
      "put": {
       "@purpose": "message:system"
      },
      "written_as": {
       "@purpose": "tool_catalog"
      },
      "find": [
       {
        "from": "text",
        "between": [
         "```tool\n",
         "\n```"
        ],
        "to": "@purpose.calls",
        "remove": true,
        "complete_reply": true
       }
      ],
      "spelling": {
       "call": "```tool\n{\"name\": \"{name}\", \"input\": {input}}\n```",
       "result": "Result of {name} ({id}):\n{output}"
      }
     }
    }
   ]
  }
 },
 "formats": {
  "*": {
   "use": "json"
  },
  "list[Tool]": {
   "use": "function_tool"
  },
  "list[ToolCall]": {
   "use": "tool_calls"
  }
 }
}
