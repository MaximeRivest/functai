{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximerivest/functai/contract/schema/event.schema.json",
  "title": "One event of a stream (functai streaming, format 2; format 1 as shown before 2026-09-28)",
  "type": "object",
  "if": {"required": ["functai_event"]},
  "then": {"$ref": "#/$defs/format2"},
  "else": {"$ref": "#/$defs/format1"},
  "$defs": {
    "format2": {
      "type": "object",
      "required": ["functai_event", "kind", "stream", "seq", "at", "call", "function"],
      "properties": {
        "functai_event": {"const": 2},
        "kind": {"enum": ["started", "text", "thinking", "tool_call", "tool_result", "retry", "done", "failed"]},
        "stream": {"$ref": "call.schema.json#/$defs/uuid"},
        "seq": {"type": "integer", "minimum": 1},
        "at": {"$ref": "call.schema.json#/$defs/time"},
        "call": {"$ref": "call.schema.json#/$defs/uuid"},
        "function": {"type": "string", "minLength": 1},
        "content": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "started"}}},
         "then": {"required": ["parent", "root", "program", "content", "saw"],
                  "properties": {"parent": {"oneOf": [{"$ref": "call.schema.json#/$defs/uuid"}, {"type": "null"}]},
                                 "root": {"$ref": "call.schema.json#/$defs/uuid"},
                                 "program": {"$ref": "call.schema.json#/$defs/program"},
                                 "inputs": {"type": "object"},
                                 "omitted": {"$ref": "call.schema.json#/properties/omitted"},
                                 "saw": {"$ref": "call.schema.json#/$defs/saw"}},
                  "allOf": [{"if": {"properties": {"content": {"const": true}}},
                             "then": {"required": ["inputs"], "not": {"required": ["omitted"]}}},
                            {"if": {"properties": {"content": {"const": false}}, "not": {"required": ["omitted"]}},
                             "then": {"not": {"required": ["inputs"]}}}]}},
        {"if": {"properties": {"kind": {"const": "text"}}},
         "then": {"required": ["field", "answer", "request"],
                  "properties": {"field": {"type": "string", "minLength": 1}, "answer": {"type": "boolean"},
                                 "request": {"$ref": "#/$defs/request"},
                                 "text": {"type": "string", "minLength": 1}, "size": {"$ref": "#/$defs/size"}},
                  "$ref": "#/$defs/text_or_size"}},
        {"if": {"properties": {"kind": {"const": "thinking"}}},
         "then": {"required": ["request"],
                  "properties": {"request": {"$ref": "#/$defs/request"},
                                 "text": {"type": "string", "minLength": 1}, "size": {"$ref": "#/$defs/size"}},
                  "$ref": "#/$defs/text_or_size"}},
        {"if": {"properties": {"kind": {"const": "tool_call"}}},
         "then": {"required": ["id", "name"],
                  "properties": {"id": {"type": ["string", "null"]}, "name": {"type": "string"}, "input": {}},
                  "if": {"$ref": "#/$defs/whole"},
                  "then": {"required": ["input"]}, "else": {"not": {"required": ["input"]}}}},
        {"if": {"properties": {"kind": {"const": "tool_result"}}},
         "then": {"required": ["id", "name"],
                  "properties": {"id": {"type": ["string", "null"]}, "name": {"type": "string"},
                                 "output": {"type": "string"}, "size": {"type": "integer", "minimum": 0}},
                  "if": {"$ref": "#/$defs/whole"},
                  "then": {"required": ["output"], "not": {"required": ["size"]}},
                  "else": {"required": ["size"], "not": {"required": ["output"]}}}},
        {"if": {"properties": {"kind": {"const": "retry"}}},
         "then": {"required": ["wait"],
                  "properties": {"reason": {"type": "string", "minLength": 1},
                                 "wait": {"type": ["number", "null"], "minimum": 0}},
                  "if": {"$ref": "#/$defs/whole"},
                  "then": {"required": ["reason"]}, "else": {"not": {"required": ["reason"]}}}},
        {"if": {"properties": {"kind": {"const": "done"}}},
         "then": {"properties": {"value": {}},
                  "if": {"$ref": "#/$defs/whole"},
                  "then": {"required": ["value"]}, "else": {"not": {"required": ["value"]}}}},
        {"if": {"properties": {"kind": {"const": "failed"}}},
         "then": {"required": ["error"],
                  "properties": {"error": {"$ref": "call.schema.json#/$defs/error"}},
                  "if": {"$ref": "#/$defs/whole"},
                  "then": {}, "else": {"properties": {"error": {"not": {"required": ["message"]}}}}}}
      ]
    },
    "whole": {"not": {"required": ["content"], "properties": {"content": {"const": false}}}},
    "request": {"type": "integer", "minimum": 1},
    "size": {"type": "integer", "minimum": 1},
    "text_or_size": {
      "if": {"$ref": "#/$defs/whole"},
      "then": {"required": ["text"], "not": {"required": ["size"]}},
      "else": {"required": ["size"], "not": {"required": ["text"]}}
    },
    "format1": {
      "type": "object",
      "required": ["kind", "call", "function"],
      "properties": {
        "kind": {"enum": ["started", "text", "thinking", "tool_call", "tool_result", "retry", "done", "failed"]},
        "call": {"$ref": "call.schema.json#/$defs/uuid"},
        "function": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "started"},
                        "parent": {"oneOf": [{"$ref": "call.schema.json#/$defs/uuid"}, {"type": "null"}]},
                        "inputs": {"type": "object"}},
         "required": ["parent", "inputs"]},
        {"properties": {"kind": {"const": "text"}, "field": {"type": "string", "minLength": 1},
                        "answer": {"type": "boolean"}, "text": {"type": "string", "minLength": 1}},
         "required": ["field", "answer", "text"]},
        {"properties": {"kind": {"const": "thinking"}, "text": {"type": "string", "minLength": 1}},
         "required": ["text"]},
        {"properties": {"kind": {"const": "tool_call"}, "id": {"type": ["string", "null"]},
                        "name": {"type": "string"}, "input": {}},
         "required": ["id", "name", "input"]},
        {"properties": {"kind": {"const": "tool_result"}, "id": {"type": ["string", "null"]},
                        "name": {"type": "string"}, "output": {"type": "string"}},
         "required": ["id", "name", "output"]},
        {"properties": {"kind": {"const": "retry"}, "reason": {"type": "string", "minLength": 1},
                        "wait": {"type": ["number", "null"], "minimum": 0}},
         "required": ["reason", "wait"]},
        {"properties": {"kind": {"const": "done"}, "value": {}}, "required": ["value"]},
        {"properties": {"kind": {"const": "failed"}, "error": {"$ref": "call.schema.json#/$defs/error"}},
         "required": ["error"]}
      ]
    }
  }
}
