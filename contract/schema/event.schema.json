{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximerivest/functai/contract/schema/event.schema.json",
  "title": "One event of a stream (functai streaming, format 1)",
  "type": "object",
  "required": ["kind", "call", "function"],
  "properties": {
    "kind": {"enum": ["started", "text", "thinking", "tool_call", "tool_result", "retry", "done", "failed"]},
    "call": {"$ref": "call.schema.json#/$defs/uuid"},
    "function": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "started"},
                    "parent": {"oneOf": [{"$ref": "call.schema.json#/$defs/uuid"}, {"type": "null"}]},
                    "inputs": {"type": "object"}},
     "required": ["parent", "inputs"]},
    {"properties": {"kind": {"const": "text"}, "field": {"type": "string", "minLength": 1},
                    "answer": {"type": "boolean"}, "text": {"type": "string", "minLength": 1}},
     "required": ["field", "answer", "text"]},
    {"properties": {"kind": {"const": "thinking"}, "text": {"type": "string", "minLength": 1}},
     "required": ["text"]},
    {"properties": {"kind": {"const": "tool_call"}, "id": {"type": ["string", "null"]},
                    "name": {"type": "string"}, "input": {}},
     "required": ["id", "name", "input"]},
    {"properties": {"kind": {"const": "tool_result"}, "id": {"type": ["string", "null"]},
                    "name": {"type": "string"}, "output": {"type": "string"}},
     "required": ["id", "name", "output"]},
    {"properties": {"kind": {"const": "retry"}, "reason": {"type": "string", "minLength": 1},
                    "wait": {"type": ["number", "null"], "minimum": 0}},
     "required": ["reason", "wait"]},
    {"properties": {"kind": {"const": "done"}, "value": {}}, "required": ["value"]},
    {"properties": {"kind": {"const": "failed"}, "error": {"$ref": "call.schema.json#/$defs/error"}},
     "required": ["error"]}
  ]
}
