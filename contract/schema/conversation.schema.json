{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maximerivest/functai/contract/schema/conversation.schema.json",
  "title": "One record of a conversation (functai conversations, format 1): conversations.md. Records are appended and never changed; a store numbers them (seq). Kinds and keys a later writer adds are allowed: a reader skips what it does not know.",
  "type": "object",
  "required": ["functai_conversation", "kind", "at"],
  "properties": {
    "functai_conversation": {"const": 1},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "seq": {"type": "integer", "minimum": 1},
    "at": {"$ref": "call.schema.json#/$defs/time"},
    "turn": {"$ref": "call.schema.json#/$defs/uuid"},
    "attempt": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "program"}}},
      "then": {
        "description": "A program's descriptor, keyed by its version: what a reader needs to show its turns.",
        "required": ["version", "name", "program_kind", "interface", "fields", "answer"],
        "properties": {
          "version": {"$ref": "call.schema.json#/$defs/sha256"},
          "name": {"type": "string", "minLength": 1},
          "program_kind": {"enum": ["ai", "module", "remote"]},
          "module": {"type": "string"},
          "signature": {"$ref": "call.schema.json#/$defs/sha256"},
          "interface": {"$ref": "interface.schema.json"},
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "direction", "purpose", "shape"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "direction": {"enum": ["input", "output"]},
                "purpose": {"type": "string"},
                "shape": {"type": "object"}
              }
            }
          },
          "answer": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "turn"}}},
      "then": {
        "description": "A turn, recorded before its call starts: its id is its call's.",
        "required": ["turn", "parent", "program", "inputs"],
        "properties": {
          "parent": {"oneOf": [{"$ref": "call.schema.json#/$defs/uuid"}, {"type": "null"}]},
          "program": {"$ref": "call.schema.json#/$defs/sha256"},
          "inputs": {"type": "object"},
          "request_id": {"type": "string"},
          "settings": {"type": "object", "properties": {"lm": {"type": "string"}}},
          "reads": {"type": "array", "items": {"$ref": "call.schema.json#/$defs/uuid"}},
          "made_by": {
            "type": "object",
            "required": ["name", "version", "call"],
            "properties": {
              "name": {"type": "string"},
              "version": {"$ref": "call.schema.json#/$defs/sha256"},
              "call": {"oneOf": [{"$ref": "call.schema.json#/$defs/uuid"}, {"type": "null"}]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "lease"}}},
      "then": {
        "required": ["turn", "holder", "until", "attempt"],
        "properties": {"holder": {"type": "string", "minLength": 1}, "until": {"$ref": "call.schema.json#/$defs/time"}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "ended"}}},
      "then": {
        "required": ["turn", "state"],
        "properties": {
          "state": {"enum": ["done", "failed", "stopped", "abandoned"]},
          "outputs": {"type": "object"},
          "value": {},
          "lmcc": {"type": "object", "description": "the lmcc turn (kernel 3a) the call made, with its steps"},
          "saw": {"$ref": "call.schema.json#/$defs/saw"},
          "error": {"$ref": "call.schema.json#/$defs/error"},
          "model": {"type": ["string", "null"]},
          "usage": {"$ref": "call.schema.json#/$defs/counts"},
          "seconds": {"type": "number", "minimum": 0}
        },
        "if": {"properties": {"state": {"const": "done"}}},
        "then": {"required": ["outputs"]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "waiting"}}},
      "then": {
        "required": ["turn", "approvals"],
        "properties": {"approvals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/approval"}}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "approval"}}},
      "then": {
        "required": ["turn", "site", "invocation", "verdict"],
        "properties": {
          "site": {"type": "string"},
          "invocation": {"type": "integer", "minimum": 1},
          "path": {"type": ["string", "null"]},
          "verdict": {"enum": ["yes", "no"]},
          "by": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "tool"}}},
      "then": {
        "required": ["turn", "site", "invocation", "id", "name", "state"],
        "properties": {
          "site": {"type": "string"},
          "invocation": {"type": "integer", "minimum": 1},
          "state": {"enum": ["started", "done", "given", "rerun"]},
          "output": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"state": {"enum": ["done", "given"]}}}, "then": {"required": ["output"]}}
        ]
      }
    },
    {
      "if": {"properties": {"kind": {"const": "reply"}}},
      "then": {
        "required": ["turn", "key", "response"],
        "properties": {"key": {"$ref": "call.schema.json#/$defs/sha256"}, "response": {"type": "object"}}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "call"}}},
      "then": {
        "description": "A remembered helper's call inside a turn.",
        "required": ["turn", "call", "site", "program", "lmcc", "saw"],
        "properties": {
          "call": {"$ref": "call.schema.json#/$defs/uuid"},
          "site": {"type": "string"},
          "program": {
            "type": "object",
            "required": ["name", "signature"],
            "properties": {"name": {"type": "string"}, "module": {"type": "string"},
                           "signature": {"$ref": "call.schema.json#/$defs/sha256"}}
          },
          "lmcc": {"type": "object"},
          "saw": {"$ref": "call.schema.json#/$defs/saw"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"enum": ["stop", "head"]}}},
      "then": {"required": ["turn"]}
    }
  ],
  "$defs": {
    "approval": {
      "type": "object",
      "required": ["call", "invocation", "id", "name", "path", "site"],
      "properties": {
        "call": {"$ref": "call.schema.json#/$defs/uuid"},
        "invocation": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "input": {},
        "effects": {"enum": ["reads", "changes", null]},
        "path": {"type": "string", "minLength": 1},
        "site": {"type": "string"}
      }
    }
  }
}
