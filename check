#!/usr/bin/env bash
# The one command. Green here = every implementation keeps the contract.
#   1) the contract itself: its schemas are valid, its cases are what
#      contract/cases/make.py writes from the rules
#   2) Python: the offline tests (a fake provider; the contract's cases and
#      schemas are read from ../contract)
#   3) TypeScript: types, then the offline tests (the same contract cases)
#   4) Python and TypeScript against each other: saved in one, loaded in the
#      other; one call log written and read by both (tools/crosslang.py)
# Each new language adds its step here: its own tests, then the contract's
# cases through it, then the cross-language check.
set -euo pipefail
cd "$(dirname "$0")"

step() { printf '\n== %s ==\n' "$1"; }

PY=python/.venv/bin/python
if [ ! -x "$PY" ]; then
  step "setup: python/.venv"
  (cd python && uv sync --frozen --all-extras --all-groups)
fi

step "1/4 the contract"
"$PY" - <<'EOF'
import glob, json, jsonschema
for path in sorted(glob.glob("contract/schema/*.json")):
    jsonschema.Draft202012Validator.check_schema(json.load(open(path)))
print(f"{len(glob.glob('contract/schema/*.json'))} schemas valid")
EOF
cases() { (cd contract/cases && find . -name '*.json' | sort | xargs sha256sum | sha256sum); }
before=$(cases)
"$PY" contract/cases/make.py >/dev/null
after=$(cases)
if [ "$before" != "$after" ]; then
  echo "contract/cases/ differ from what make.py writes: commit make.py's output, or fix make.py" >&2
  exit 1
fi
echo "cases match make.py"

step "2/4 python"
(cd python && HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}" .venv/bin/python -m pytest -q -p no:cacheprovider)

step "3/4 typescript"
if [ ! -d ts/node_modules ]; then
  # lmcc's TypeScript kernel is not on npm yet: ts/package.json links ../../lmcc/ts
  if [ ! -f ../lmcc/ts/package.json ]; then
    echo "ts/ needs lmcc checked out next to this repository (../lmcc), until lmcc is published to npm" >&2
    exit 1
  fi
  (cd ts && npm install --no-audit --no-fund)
fi
(cd ts && npx tsc --noEmit && npm test --silent 2>&1 | grep -E '^ℹ (tests|pass|fail)|^✖' ; exit "${PIPESTATUS[0]}")

step "4/4 python x typescript"
"$PY" tools/crosslang.py

printf '\nall green\n'
