{
  "name": "functai",
  "version": "1.0.0",
  "description": "Typed functions whose body is a language model call: write the signature, a model writes the body, you measure how well. The TypeScript implementation of the FunctAI contract.",
  "type": "module",
  "license": "MIT",
  "author": "Maxime Rivest <maxime.rivest@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximeRivest/functai.git",
    "directory": "ts"
  },
  "homepage": "https://maximerivest.github.io/functai/ts/index.html",
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": [
    "./src/files.ts",
    "./dist/files.js"
  ],
  "exports": {
    ".": {
      "functai-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./files": {
      "functai-source": "./src/files.ts",
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --conditions=functai-source --test --test-timeout=60000 tests/*.test.ts",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "docs": "typedoc"
  },
  "dependencies": {
    "@lm15/lm15": "^2.0.0",
    "lmcc": "^0.8.8"
  },
  "peerDependencies": {
    "attachments-dev": ">=0.1.0 <2"
  },
  "peerDependenciesMeta": {
    "attachments-dev": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "attachments-dev": ">=0.1.0 <2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9",
    "zod": "^4.6.5"
  }
}
